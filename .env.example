# Template di configurazione — Copiare in .env e configurare le credenziali reali
# NON committare il file .env su git

ENVIRONMENT=development
JWT_SECRET=change_this_to_a_secure_random_secret_string
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

DB_USER=crypto_user
DB_PASSWORD=crypto_pass
DB_NAME=cryptoscalper_db
DB_HOST=timescaledb
DB_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

PAPER_TRADING=true
STARTING_CAPITAL=500
WATCHED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,DOTUSDT,LINKUSDT,NEARUSDT

CRYPTOCOM_API_KEY=your_cryptocom_api_key_here
CRYPTOCOM_API_SECRET=your_cryptocom_api_secret_here
CRYPTOCOM_API_BASE_URL=https://api.crypto.com/exchange/v1

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

GROQ_API_KEY=your_groq_api_key_here

ALLOW_MOCK_TRADES=false
CORS_ORIGINS=http://localhost:3000

VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
